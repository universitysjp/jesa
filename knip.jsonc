{
	"$schema": "https://unpkg.com/knip/schema.json",
	// Next.js, Bun tests, Playwright, and package scripts are discovered by plugins.
	// This operational CLI is intentionally runnable outside package scripts.
	"entry": ["data/verify-database.ts"],
	"project": [
		"**/*.{ts,tsx,js,mjs,cjs,css}",
		"!.next/**",
		"!node_modules/**",
		"!next-env.d.ts"
	],
	// Locally consumed exports still implement live behavior (including Firebase helpers).
	"ignoreExportsUsedInFile": true,
	"ignoreDependencies": ["@radix-ui/react-tooltip"],
	"ignoreIssues": {
		// Archived registration and presentation code is retained for future events.
		"app/(site)/register/external/external-register-form.tsx": ["files"],
		"app/(site)/register/internal/internal-register-form.tsx": ["files"],
		"components/{annoucement,countdown-timer,sponsors}.tsx": ["files"],
		"app/(admin)/admin/EmailService/email-images.ts": ["files"],
		"components/ui/{title,tooltip}.tsx": ["files", "exports"],
		"constants/sponsors.ts": ["files"],
		// Preserve the shared shadcn primitive APIs, even when only part is consumed.
		"components/ui/{button,dialog,form,input,select}.tsx": ["exports", "types"],
		// These values are consumed dynamically through Object.values/getEnumValues.
		"constants/form.ts": ["enumMembers", "types"],
		// Firebase audit/auth helpers are intentionally outside maintenance cleanup.
		"app/admin/lib/{audit,server-auth}.ts": ["exports"],
		"app/(site)/awards/awards-card.tsx": ["exports", "duplicates"],
		"lib/awards.ts": ["exports"]
	}
}
